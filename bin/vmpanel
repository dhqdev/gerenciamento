#!/usr/bin/env bash
# VM//PANEL - ferramenta de linha de comando (instalacao, atualizacao e manutencao)
set -euo pipefail

APP_DIR="${VMPANEL_DIR:-/opt/vmpanel}"
CONF_DIR="/etc/vmpanel"
DATA_DIR="/var/lib/vmpanel"
ENV_FILE="$CONF_DIR/env"
SVC_USER="vmpanel"
CADDY_SITE="/etc/caddy/vmpanel.caddy"
CADDYFILE="/etc/caddy/Caddyfile"

G=$'\033[1;32m'; Y=$'\033[1;33m'; R=$'\033[1;31m'; D=$'\033[2m'; N=$'\033[0m'
say()  { printf '%s>%s %s\n' "$G" "$N" "$*"; }
warn() { printf '%s!%s %s\n' "$Y" "$N" "$*"; }
die()  { printf '%sx %s%s\n' "$R" "$*" "$N" >&2; exit 1; }

need_root() { [ "$(id -u)" -eq 0 ] || die "Rode como root: sudo vmpanel $*"; }

# le do terminal mesmo quando veio de `curl | bash`
ask() {
  local prompt="$1" default="${2:-}" ans=""
  if { : </dev/tty; } 2>/dev/null; then
    read -r -p "$prompt" ans < /dev/tty || true
  fi
  printf '%s' "${ans:-$default}"
}

get_env() { [ -f "$ENV_FILE" ] && grep -E "^$1=" "$ENV_FILE" | tail -1 | cut -d= -f2- || true; }
set_env() {
  mkdir -p "$CONF_DIR"; touch "$ENV_FILE"
  if grep -qE "^$1=" "$ENV_FILE"; then sed -i "s|^$1=.*|$1=$2|" "$ENV_FILE"; else echo "$1=$2" >> "$ENV_FILE"; fi
}
port() { local p; p="$(get_env VMPANEL_PORT)"; echo "${p:-8787}"; }

export DEBIAN_FRONTEND=noninteractive NEEDRESTART_MODE=a

# espera o apt liberar (VM recem-criada costuma estar rodando unattended-upgrades)
apt_get() { apt-get -o DPkg::Lock::Timeout=600 "$@"; }

pkg_mgr() {
  if command -v apt-get >/dev/null 2>&1; then echo apt
  elif command -v dnf >/dev/null 2>&1; then echo dnf
  elif command -v yum >/dev/null 2>&1; then echo yum
  else echo none; fi
}

arch_go() {
  case "$(uname -m)" in
    x86_64|amd64) echo amd64 ;;
    aarch64|arm64) echo arm64 ;;
    armv7l) echo armv7 ;;
    *) die "Arquitetura nao suportada: $(uname -m)" ;;
  esac
}

# ------------------------------------------------------------------ caddy (HTTPS automatico)
install_caddy() {
  if command -v caddy >/dev/null 2>&1; then say "Caddy ja instalado: $(caddy version | head -1)"; return; fi
  say "Instalando Caddy (proxy reverso com HTTPS automatico Let's Encrypt)..."
  case "$(pkg_mgr)" in
    apt)
      # 1) repositorio oficial do Caddy (versao mais recente)
      local key=/usr/share/keyrings/caddy-stable-archive-keyring.gpg list=/etc/apt/sources.list.d/caddy-stable.list
      apt_get install -y -qq debian-keyring debian-archive-keyring apt-transport-https gnupg >/dev/null 2>&1 || true
      if curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/gpg.key' | gpg --dearmor --yes -o "$key" 2>/dev/null \
        && curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/debian.deb.txt' > "$list" \
        && apt_get update -qq >/dev/null 2>&1 && apt_get install -y -qq caddy >/dev/null 2>&1; then
        return
      fi
      rm -f "$list" "$key"   # nao deixa repositorio quebrado para tras
      # 2) pacote da propria distro (Ubuntu 22.04+ / Debian 12+)
      if apt_get install -y -qq caddy >/dev/null 2>&1; then return; fi ;;
    dnf|yum)
      if "$(pkg_mgr)" install -y -q 'dnf-command(copr)' >/dev/null 2>&1 && dnf copr enable -y @caddy/caddy >/dev/null 2>&1 \
        && dnf install -y -q caddy >/dev/null 2>&1; then
        return
      fi ;;
  esac
  # 3) binario oficial do GitHub
  warn "Pacote do Caddy indisponivel; baixando binario oficial..."
  local ver tmp
  tmp="$(mktemp -d)"
  ver="$(curl -fsSIL -o /dev/null -w '%{url_effective}' https://github.com/caddyserver/caddy/releases/latest 2>/dev/null | sed -n 's|.*/tag/||p')"
  if [ -n "$ver" ] && curl -fsSL "https://github.com/caddyserver/caddy/releases/download/${ver}/caddy_${ver#v}_linux_$(arch_go).tar.gz" | tar xz -C "$tmp" caddy 2>/dev/null; then
    :
  # 4) servidor de downloads do Caddy
  elif curl -fsSL -o "$tmp/caddy" "https://caddyserver.com/api/download?os=linux&arch=$(arch_go)"; then
    :
  else
    rm -rf "$tmp"
    die "Nao consegui baixar o Caddy. Verifique a internet da VM e rode de novo: sudo vmpanel setup"
  fi
  install -m 0755 "$tmp/caddy" /usr/local/bin/caddy
  rm -rf "$tmp"
  getent group caddy >/dev/null || groupadd --system caddy
  id caddy >/dev/null 2>&1 || useradd --system --gid caddy --create-home --home-dir /var/lib/caddy --shell /usr/sbin/nologin caddy
  install -m 0644 "$APP_DIR/deploy/caddy.service" /etc/systemd/system/caddy.service
  systemctl daemon-reload
  systemctl enable caddy >/dev/null 2>&1
}

write_caddy() {
  local domain="$1"
  mkdir -p /etc/caddy
  sed -e "s|__DOMAIN__|$domain|g" -e "s|__PORT__|$(port)|g" "$APP_DIR/deploy/caddy-site.tmpl" > "$CADDY_SITE"
  local email; email="$(get_env VMPANEL_EMAIL)"
  if [ ! -f "$CADDYFILE" ] || grep -q '^# Gerenciado pelo VM//PANEL' "$CADDYFILE" || grep -qE '^:80[[:space:]]*\{' "$CADDYFILE"; then
    # Caddyfile nosso ou o padrao do pacote (pagina de exemplo na porta 80): regera
    [ -f "$CADDYFILE" ] && cp "$CADDYFILE" "$CADDYFILE.bak.$(date +%s)"
    {
      echo "# Gerenciado pelo VM//PANEL"
      if [ -n "$email" ]; then printf '{\n\temail %s\n}\n\n' "$email"; fi
      echo "import $CADDY_SITE"
    } > "$CADDYFILE"
  elif ! grep -qF "import $CADDY_SITE" "$CADDYFILE"; then
    # ja existe um Caddyfile do usuario: so acrescenta o import
    cp "$CADDYFILE" "$CADDYFILE.bak.$(date +%s)"
    printf '\nimport %s\n' "$CADDY_SITE" >> "$CADDYFILE"
  fi
  caddy validate --config "$CADDYFILE" --adapter caddyfile >/dev/null 2>&1 || {
    caddy validate --config "$CADDYFILE" --adapter caddyfile || true
    die "Configuracao do Caddy invalida (veja acima)."
  }
  systemctl enable caddy >/dev/null 2>&1 || true
  systemctl restart caddy
}

remove_caddy_site() {
  rm -f "$CADDY_SITE"
  if [ -f "$CADDYFILE" ]; then
    sed -i "\|import $CADDY_SITE|d" "$CADDYFILE"
    if ! grep -vE '^\s*(#|$)' "$CADDYFILE" | grep -qvE '^\s*(\{|\}|email )'; then
      # sobrou so o bloco global: deixa um Caddyfile vazio valido
      echo "# Gerenciado pelo VM//PANEL (sem sites)" > "$CADDYFILE"
    fi
    if systemctl is-active --quiet caddy; then systemctl reload caddy 2>/dev/null || true; fi
  fi
}

# ------------------------------------------------------------------ firewall
# As regras sao aplicadas por um servico de boot (vmpanel-firewall), sem salvar o iptables
# inteiro: assim nenhuma regra do Docker ou de outros programas e tocada.
fw_rule() {  # fw_rule add|del <args do iptables>
  local op="$1"; shift
  command -v iptables >/dev/null 2>&1 || return 0
  if [ "$op" = add ]; then
    iptables -C INPUT "$@" 2>/dev/null || iptables -I INPUT 1 "$@"
  else
    while iptables -C INPUT "$@" 2>/dev/null; do iptables -D INPUT "$@"; done
  fi
}

fw_rules() {  # imprime as regras do modo atual, uma por linha
  case "$(get_env VMPANEL_PROXY)" in
    caddy)
      echo "-p tcp -m state --state NEW --dport 80 -j ACCEPT"
      echo "-p tcp -m state --state NEW --dport 443 -j ACCEPT" ;;
    traefik)
      local sub; sub="$(get_env VMPANEL_PROXY_SUBNET)"
      [ -n "$sub" ] && echo "-s $sub -p tcp --dport $(port) -j ACCEPT" ;;
  esac
  return 0
}

cmd_firewall() {  # chamado no boot pelo vmpanel-firewall.service
  local r
  while read -r r; do [ -n "$r" ] && eval "fw_rule add $r"; done < <(fw_rules)
  return 0
}

fw_clear() {
  local r
  while read -r r; do [ -n "$r" ] && eval "fw_rule del $r"; done < <(fw_rules)
  return 0
}

open_firewall() {
  say "Liberando o acesso no firewall da VM..."
  if [ "$(get_env VMPANEL_PROXY)" = caddy ]; then
    if command -v firewall-cmd >/dev/null 2>&1 && systemctl is-active --quiet firewalld; then
      firewall-cmd --permanent --add-service=http --add-service=https >/dev/null
      firewall-cmd --reload >/dev/null
    fi
    if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q "Status: active"; then
      ufw allow 80/tcp >/dev/null; ufw allow 443/tcp >/dev/null
    fi
  fi
  # Imagens Ubuntu da Oracle vem com iptables bloqueando (REJECT) tudo menos SSH
  if command -v iptables >/dev/null 2>&1 && iptables -S INPUT 2>/dev/null | grep -q -- "-j REJECT"; then
    cmd_firewall
  fi
  cat > /etc/systemd/system/vmpanel-firewall.service <<UNIT
[Unit]
Description=VM//PANEL - regras de firewall do painel
After=network-online.target docker.service netfilter-persistent.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/vmpanel firewall
RemainAfterExit=true

[Install]
WantedBy=multi-user.target
UNIT
  systemctl daemon-reload
  systemctl enable vmpanel-firewall >/dev/null 2>&1 || true
}

# ------------------------------------------------------------------ portas 80/443
port_owner() {  # quem esta escutando na porta (vazio = livre)
  ss -tlnpH "sport = :$1" 2>/dev/null | sed -n 's/.*users:(("\([^"]*\)".*/\1/p' | head -1
}

caddy_is_ours() { [ -f "$CADDYFILE" ] && grep -q '^# Gerenciado pelo VM//PANEL' "$CADDYFILE"; }

disable_our_caddy() {
  # so mexe no Caddy se fomos nos que configuramos (nunca em um Caddy seu)
  remove_caddy_site
  if caddy_is_ours && ! grep -qE '^[^#[:space:]{}]' "$CADDYFILE"; then
    systemctl disable --now caddy >/dev/null 2>&1 || true
  fi
}

# ------------------------------------------------------------------ modo Traefik (Docker)
detect_traefik() {
  TRAEFIK_MODE=""; TRAEFIK_NAME=""; TRAEFIK_NETWORK=""; TRAEFIK_ENTRYPOINT=""; TRAEFIK_RESOLVER=""
  command -v docker >/dev/null 2>&1 || return 1
  local k v
  while IFS='=' read -r k v; do
    case "$k" in
      TRAEFIK_MODE|TRAEFIK_NAME|TRAEFIK_NETWORK|TRAEFIK_ENTRYPOINT|TRAEFIK_RESOLVER)
        [[ "$v" =~ ^[A-Za-z0-9_.-]*$ ]] && printf -v "$k" '%s' "$v" ;;
    esac
  done < <(python3 "$APP_DIR/app/traefik_detect.py")
  [ -n "$TRAEFIK_MODE" ]
}

setup_traefik() {
  local domain="$1" gw sub node
  say "Traefik detectado ($TRAEFIK_MODE: $TRAEFIK_NAME). O painel vai entrar por ele, sem mexer nos seus servicos."
  [ -n "$TRAEFIK_NETWORK" ] || die "Nao descobri a rede do Traefik. Me mande a saida de: docker network ls"
  say "Rede: $TRAEFIK_NETWORK | entrypoint: $TRAEFIK_ENTRYPOINT | certificado: ${TRAEFIK_RESOLVER:-(padrao do Traefik)}"

  local gwnet="$TRAEFIK_NETWORK"
  [ "$TRAEFIK_MODE" = swarm ] && gwnet="docker_gwbridge"
  gw="$(docker network inspect "$gwnet" --format '{{range .IPAM.Config}}{{.Gateway}} {{end}}' 2>/dev/null | awk '{print $1}')"
  sub="$(docker network inspect "$gwnet" --format '{{range .IPAM.Config}}{{.Subnet}} {{end}}' 2>/dev/null | awk '{print $1}')"
  [ -n "$gw" ] && [ -n "$sub" ] || die "Nao consegui ler a rede $gwnet do Docker."

  # o painel passa a escutar tambem no IP interno do Docker (nunca na internet)
  set_env VMPANEL_HOST "127.0.0.1,$gw"
  set_env VMPANEL_TRUSTED_PROXIES "127.0.0.1/32,::1/128,$sub"
  set_env VMPANEL_PROXY traefik
  set_env VMPANEL_PROXY_SUBNET "$sub"
  open_firewall
  systemctl restart vmpanel
  local ok=""
  for _ in $(seq 1 20); do
    curl -fsS -m 2 "http://$gw:$(port)/healthz" >/dev/null 2>&1 && { ok=1; break; }
    sleep 1
  done
  [ -n "$ok" ] || die "O painel nao respondeu em $gw:$(port). Rode: sudo vmpanel logs"

  # ponte minima (socat) dentro da rede do Traefik encaminhando para o painel no host
  local labels=(
    --label "traefik.enable=true"
    --label "traefik.docker.network=$TRAEFIK_NETWORK"
    --label "traefik.http.routers.vmpanel.rule=Host(\`$domain\`)"
    --label "traefik.http.routers.vmpanel.entrypoints=$TRAEFIK_ENTRYPOINT"
    --label "traefik.http.routers.vmpanel.tls=true"
    --label "traefik.http.routers.vmpanel.service=vmpanel"
    --label "traefik.http.services.vmpanel.loadbalancer.server.port=8787"
  )
  [ -n "$TRAEFIK_RESOLVER" ] && labels+=(--label "traefik.http.routers.vmpanel.tls.certresolver=$TRAEFIK_RESOLVER")
  local cmd=(alpine/socat -d "TCP-LISTEN:8787,fork,reuseaddr" "TCP:$gw:$(port)")

  remove_traefik_proxy quiet
  say "Publicando a rota https://$domain no Traefik..."
  if [ "$TRAEFIK_MODE" = swarm ]; then
    node="$(docker info --format '{{.Swarm.NodeID}}')"
    docker service create --detach --quiet --name vmpanel-proxy --network "$TRAEFIK_NETWORK" \
      --constraint "node.id==$node" --limit-memory 32M --restart-condition any \
      "${labels[@]}" "${cmd[@]}" >/dev/null
  else
    docker run -d --name vmpanel-proxy --restart unless-stopped --network "$TRAEFIK_NETWORK" \
      --memory 32m "${labels[@]}" "${cmd[@]}" >/dev/null
  fi
  disable_our_caddy
}

remove_traefik_proxy() {
  command -v docker >/dev/null 2>&1 || return 0
  docker service rm vmpanel-proxy >/dev/null 2>&1 || true
  docker rm -f vmpanel-proxy >/dev/null 2>&1 || true
  [ "${1:-}" = quiet ] || say "Rota do painel removida do Traefik."
}

public_ip() {
  curl -fsS -m 5 https://api.ipify.org 2>/dev/null || curl -fsS -m 5 https://ifconfig.me 2>/dev/null || true
}

check_dns() {
  local domain="$1" mine theirs
  mine="$(public_ip)"
  theirs="$(getent ahostsv4 "$domain" 2>/dev/null | awk 'NR==1{print $1}')"
  if [ -z "$theirs" ]; then
    warn "O dominio $domain ainda nao resolve. Crie um registro A apontando para ${mine:-o IP publico da VM}."
    return 1
  elif [ -n "$mine" ] && [ "$theirs" != "$mine" ]; then
    warn "$domain aponta para $theirs, mas o IP publico desta VM parece ser $mine."
    warn "(Se usa Cloudflare com proxy laranja, deixe o registro em 'DNS only' para o certificado ser emitido.)"
    return 1
  fi
  say "DNS ok: $domain -> $theirs"
}

# ------------------------------------------------------------------ servico
install_service() {
  getent group "$SVC_USER" >/dev/null || groupadd --system "$SVC_USER"
  id "$SVC_USER" >/dev/null 2>&1 || useradd --system --gid "$SVC_USER" --no-create-home --home-dir "$DATA_DIR" --shell /usr/sbin/nologin "$SVC_USER"
  local g
  for g in docker systemd-journal adm; do
    getent group "$g" >/dev/null && usermod -aG "$g" "$SVC_USER" || true
  done
  mkdir -p "$CONF_DIR" "$DATA_DIR"
  chmod 0750 "$CONF_DIR"
  chown root:"$SVC_USER" "$CONF_DIR"
  chown "$SVC_USER":"$SVC_USER" "$DATA_DIR"
  [ -f "$ENV_FILE" ] || printf 'VMPANEL_HOST=127.0.0.1\nVMPANEL_PORT=8787\n' > "$ENV_FILE"
  chmod 0640 "$ENV_FILE"; chown root:"$SVC_USER" "$ENV_FILE"
  install -m 0644 "$APP_DIR/deploy/vmpanel.service" /etc/systemd/system/vmpanel.service
  install -m 0644 "$APP_DIR/deploy/vmpanel-agent.service" /etc/systemd/system/vmpanel-agent.service
  # usuario do terminal web: quem rodou o sudo (ex.: ubuntu), senao o primeiro usuario normal
  if [ -z "$(get_env VMPANEL_TERM_USER)" ]; then
    local tu="${SUDO_USER:-}"
    [ -n "$tu" ] && [ "$tu" != root ] || tu="$(getent passwd 1000 | cut -d: -f1)"
    [ -n "$tu" ] || tu="$(getent passwd ubuntu opc | head -1 | cut -d: -f1)"
    set_env VMPANEL_TERM_USER "${tu:-root}"
  fi
  [ -n "$(get_env VMPANEL_TERMINAL)" ] || set_env VMPANEL_TERMINAL on
  ln -sf "$APP_DIR/bin/vmpanel" /usr/local/bin/vmpanel
  chmod 0755 "$APP_DIR/bin/vmpanel"
  systemctl daemon-reload
  systemctl enable vmpanel vmpanel-agent >/dev/null 2>&1
  systemctl restart vmpanel-agent >/dev/null 2>&1 || true
}

manage() { VMPANEL_AUTH="$CONF_DIR/auth.json" python3 "$APP_DIR/app/manage.py" "$@"; }

wait_up() {
  for _ in $(seq 1 20); do
    curl -fsS -m 2 "http://127.0.0.1:$(port)/healthz" >/dev/null 2>&1 && return 0
    sleep 1
  done
  return 1
}

# ------------------------------------------------------------------ comandos
cmd_setup() {
  need_root setup
  install_service

  if ! command -v docker >/dev/null 2>&1; then
    local d="${VMPANEL_DOCKER:-}"
    [ -n "$d" ] || d="$(ask "Docker nao encontrado. Instalar agora? [s/N]: " n)"
    if [[ "$d" =~ ^[sSyY] ]]; then
      say "Instalando Docker (get.docker.com)..."
      if curl -fsSL https://get.docker.com | sh; then
        systemctl enable --now docker || true
        usermod -aG docker "$SVC_USER"
      else
        warn "Nao consegui instalar o Docker agora. Depois de instalar, rode: sudo vmpanel restart"
      fi
    fi
  fi

  if manage check; then
    say "Credenciais ja existem (troque com: sudo vmpanel passwd)"
  else
    echo
    say "Crie o login UNICO do painel. A senha e guardada so como hash scrypt."
    manage passwd
    local tf="${VMPANEL_2FA:-}"
    [ -n "$tf" ] || tf="$(ask "Ativar 2FA (Google Authenticator/Authy)? Recomendado. [S/n]: " s)"
    if [[ "$tf" =~ ^[sSyY] ]]; then manage 2fa-on || warn "2FA nao ativado. Ative depois com: sudo vmpanel 2fa-on"; fi
  fi

  local domain="${VMPANEL_DOMAIN:-}"
  if [ -z "$domain" ] && [ -z "$(get_env VMPANEL_DOMAIN)" ]; then
    echo
    local ip; ip="$(public_ip)"
    say "Dominio do painel (ex.: painel.seudominio.com). O registro DNS A deve apontar para ${D}${ip:-o IP publico da VM}${N}"
    domain="$(ask "Dominio (vazio = acesso so por tunel SSH): " "")"
  fi
  domain="${domain:-$(get_env VMPANEL_DOMAIN)}"
  if [ -n "$domain" ]; then
    local email="${VMPANEL_EMAIL:-$(get_env VMPANEL_EMAIL)}"
    [ -n "$email" ] || email="$(ask "E-mail para o Let's Encrypt (avisos de certificado, opcional): " "")"
    [ -n "$email" ] && set_env VMPANEL_EMAIL "$email"
  fi

  systemctl restart vmpanel
  wait_up || { journalctl -u vmpanel -n 30 --no-pager; die "O servico nao subiu."; }

  if [ -n "$domain" ]; then
    cmd_domain "$domain"
  else
    set_env VMPANEL_DOMAIN ""
    finish_msg ""
  fi
}

cmd_domain() {
  need_root domain
  local domain="${1:-}"
  [ -n "$domain" ] || die "uso: vmpanel domain painel.seudominio.com   (ou 'vmpanel domain off')"
  if [ "$domain" = "off" ]; then
    remove_traefik_proxy quiet
    fw_clear
    remove_caddy_site
    set_env VMPANEL_HOST "127.0.0.1"; set_env VMPANEL_TRUSTED_PROXIES "127.0.0.1/32,::1/128"
    set_env VMPANEL_PROXY ""; set_env VMPANEL_DOMAIN ""
    systemctl restart vmpanel
    say "Dominio removido. Acesso apenas via tunel SSH."; return
  fi
  [[ "$domain" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$ ]] || die "Dominio invalido: $domain"
  check_dns "$domain" || warn "Vou configurar mesmo assim; o HTTPS sai assim que o DNS propagar."
  set_env VMPANEL_DOMAIN "$domain"

  if detect_traefik; then
    setup_traefik "$domain"
  else
    # sem Traefik: usa o Caddy, mas so se as portas estiverem livres (ou ja forem do Caddy)
    local p o
    for p in 80 443; do
      o="$(port_owner "$p")"
      if [ -n "$o" ] && [ "$o" != caddy ]; then
        die "A porta $p ja esta em uso por '$o'. Nao vou mexer nela. Me mande a saida de: sudo ss -tlnp | grep -E ':(80|443) '"
      fi
    done
    set_env VMPANEL_PROXY caddy
    install_caddy
    open_firewall
    write_caddy "$domain"
  fi
  set_env VMPANEL_DOMAIN "$domain"
  finish_msg "$domain"
}

finish_msg() {
  local domain="$1"
  echo
  printf '%s' "$G"
  cat <<'ART'
 __   ____  __    __  __  ___  _   _  _ ___ _
 \ \ / /  \/  |  / / / / | _ \/_\ | \| | __| |
  \ V /| |\/| | / / / /  |  _/ _ \| .` | _|| |__
   \_/ |_|  |_|/_/ /_/   |_|/_/ \_\_|\_|___|____|
ART
  printf '%s\n' "$N"
  if [ -n "$domain" ]; then
    say "Pronto! Acesse: ${G}https://$domain${N}"
    echo "  O certificado HTTPS e emitido automaticamente no primeiro acesso (pode levar ~1 min)."
    warn "Na Oracle Cloud, libere tambem as portas 80 e 443 na Security List / NSG da VCN:"
    echo "  Console > Networking > Virtual Cloud Networks > sua VCN > Security Lists > Add Ingress Rules"
    echo "  Source CIDR 0.0.0.0/0, TCP, Destination Port 80 e depois 443."
  else
    say "Painel rodando somente em 127.0.0.1:$(port) (nada exposto na internet)."
    echo "  No seu computador: ssh -L $(port):127.0.0.1:$(port) usuario@IP_DA_VM"
    echo "  Depois abra: http://localhost:$(port)"
    echo "  Para publicar num dominio depois: sudo vmpanel domain painel.seudominio.com"
  fi
  echo "  Ajuda: vmpanel help"
}

cmd_update() {
  need_root update
  say "Atualizando a partir do GitHub..."
  local branch
  branch="$(git -C "$APP_DIR" rev-parse --abbrev-ref HEAD)"
  git -C "$APP_DIR" fetch --quiet origin "$branch"
  local old new
  old="$(git -C "$APP_DIR" rev-parse --short HEAD)"
  git -C "$APP_DIR" reset --quiet --hard "origin/$branch"
  new="$(git -C "$APP_DIR" rev-parse --short HEAD)"
  install_service
  local domain; domain="$(get_env VMPANEL_DOMAIN)"
  if [ -z "$domain" ] && [ -f "$CADDY_SITE" ]; then
    # instalacoes antigas em que o Caddy falhou antes de gravar o dominio
    domain="$(awk '/^[A-Za-z0-9.-]+[[:space:]]*\{/{print $1; exit}' "$CADDY_SITE")"
  fi
  if [ -n "$domain" ] && detect_traefik; then
    setup_traefik "$domain"   # tambem migra instalacoes antigas que tentaram usar o Caddy
    set_env VMPANEL_DOMAIN "$domain"
  elif [ -n "$domain" ] && [ -f "$CADDY_SITE" ]; then
    write_caddy "$domain"
  fi
  systemctl restart vmpanel
  if wait_up; then say "Atualizado: $old -> $new"; else die "Servico nao subiu apos atualizar (vmpanel logs)"; fi
}

cmd_doctor() {
  echo "== servico";  systemctl is-active vmpanel || true
  echo "== porta";    curl -fsS -m 3 "http://127.0.0.1:$(port)/healthz" && echo || echo "sem resposta em 127.0.0.1:$(port)"
  echo "== credenciais"; [ -f "$CONF_DIR/auth.json" ] && echo "ok" || echo "FALTANDO (sudo vmpanel passwd)"
  echo "== docker"
  if [ -S /var/run/docker.sock ]; then
    id -nG "$SVC_USER" 2>/dev/null | grep -qw docker && echo "ok (usuario $SVC_USER no grupo docker)" \
      || echo "usuario $SVC_USER sem acesso ao Docker -> rode: sudo vmpanel restart"
  else echo "docker nao instalado"; fi
  local domain; domain="$(get_env VMPANEL_DOMAIN)"
  echo "== dominio: ${domain:-(nenhum, so tunel SSH)}"
  if [ -n "$domain" ]; then
    check_dns "$domain" || true
    if [ "$(get_env VMPANEL_PROXY)" = traefik ]; then
      echo "modo: atras do Traefik"
      if docker service ls --format '{{.Name}} {{.Replicas}}' 2>/dev/null | grep -q '^vmpanel-proxy 1/1' \
        || docker ps --format '{{.Names}}' 2>/dev/null | grep -qx vmpanel-proxy; then echo "ponte vmpanel-proxy rodando"
      else echo "ponte vmpanel-proxy PARADA (docker service ps vmpanel-proxy)"; fi
    else
      systemctl is-active caddy >/dev/null 2>&1 && echo "caddy ativo" || echo "caddy PARADO (journalctl -u caddy)"
    fi
    local lc; lc="$(curl -sk -m 8 -o /dev/null -w "%{http_code}" --resolve "$domain:443:127.0.0.1" "https://$domain/healthz" 2>/dev/null || true)"
    [ "$lc" = "200" ] && echo "rota local ok (proxy -> painel)" || echo "rota local FALHOU (HTTP $lc)"
    local code; code="$(curl -sS -m 8 -o /dev/null -w "%{http_code}" "https://$domain/healthz" 2>/dev/null || true)"
    if [ "$code" = "200" ]; then say "https://$domain respondendo (HTTP 200)"; else warn "HTTPS ainda nao responde (DNS, Security List da Oracle ou certificado pendente)"; fi
  fi
  echo "== versao"; git -C "$APP_DIR" log -1 --format='%h %cd %s' --date=short 2>/dev/null || true
}

cmd_uninstall() {
  need_root uninstall
  if [ "${VMPANEL_YES:-}" != 1 ]; then
    local c; c="$(ask "Remover o VM//PANEL (servico, dados e credenciais)? Digite REMOVER: " "")"
    [ "$c" = "REMOVER" ] || die "Cancelado."
  fi
  remove_traefik_proxy quiet
  fw_clear
  systemctl disable --now vmpanel vmpanel-agent vmpanel-firewall 2>/dev/null || true
  rm -f /etc/systemd/system/vmpanel.service /etc/systemd/system/vmpanel-agent.service \
    /etc/systemd/system/vmpanel-firewall.service /usr/local/bin/vmpanel
  systemctl daemon-reload
  disable_our_caddy
  rm -rf "$CONF_DIR" "$DATA_DIR" "$APP_DIR"
  userdel "$SVC_USER" 2>/dev/null || true
  say "VM//PANEL removido. Seus containers, o Docker e o Traefik nao foram tocados."
}

usage() {
  cat <<EOF
VM//PANEL - uso: sudo vmpanel <comando>

  status        estado do servico
  logs          logs ao vivo do painel
  restart       reinicia o painel
  update        baixa a ultima versao do GitHub e reinicia
  passwd        troca usuario e senha (derruba sessoes abertas)
  2fa-on        ativa 2FA (TOTP) com QR code
  2fa-off       desativa 2FA
  domain <dom>  publica em um dominio com HTTPS ('domain off' para remover)
  terminal ...  liga/desliga o terminal web (on|off|user <nome>)
  doctor        diagnostico completo
  setup         reexecuta a configuracao inicial
  uninstall     remove o painel
EOF
}

case "${1:-help}" in
  setup)     cmd_setup ;;
  update)    cmd_update ;;
  domain)    shift; cmd_domain "${1:-}" ;;
  passwd)    need_root passwd; manage passwd; chown root:"$SVC_USER" "$CONF_DIR/auth.json"; chmod 0640 "$CONF_DIR/auth.json" ;;
  2fa-on)    need_root 2fa-on; manage 2fa-on; chown root:"$SVC_USER" "$CONF_DIR/auth.json"; chmod 0640 "$CONF_DIR/auth.json" ;;
  2fa-off)   need_root 2fa-off; manage 2fa-off; chown root:"$SVC_USER" "$CONF_DIR/auth.json"; chmod 0640 "$CONF_DIR/auth.json" ;;
  status)    systemctl status vmpanel --no-pager ;;
  logs)      journalctl -u vmpanel -f -n 100 ;;
  restart)   need_root restart; install_service; systemctl restart vmpanel; wait_up && say "ok" ;;
  doctor)    cmd_doctor ;;
  uninstall) cmd_uninstall ;;
  firewall)  need_root firewall; cmd_firewall ;;
  terminal)
    need_root terminal
    case "${2:-}" in
      on|off) set_env VMPANEL_TERMINAL "$2"; say "Terminal web: $2" ;;
      user)   id "${3:-}" >/dev/null 2>&1 || die "uso: vmpanel terminal user <usuario existente>"
              set_env VMPANEL_TERM_USER "$3"; say "Terminal web abre como: $3" ;;
      *) echo "Terminal web: $(get_env VMPANEL_TERMINAL) (usuario: $(get_env VMPANEL_TERM_USER))"
         echo "uso: vmpanel terminal on|off | vmpanel terminal user <usuario>" ;;
    esac ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
